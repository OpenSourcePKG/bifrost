# Port Bifröst listens on (this is what Claude Code's ANTHROPIC_BASE_URL points at)
PORT=8787

# Upstream MimirMind OpenAI-compatible base URL (must include the /v1 suffix)
UPSTREAM_BASE_URL=http://localhost:8080/v1

# Bearer token Bifröst sends to MimirMind (the key MimirMind auto-generates & logs on start)
UPSTREAM_API_KEY=

# If set, clients (Claude Code) MUST present this key via x-api-key / Authorization.
# Leave empty for an open local bridge.
CLIENT_API_KEY=

# Force every request onto this upstream model id, regardless of what Claude Code asks for.
# Leave empty to pass the client-requested model through unchanged.
UPSTREAM_MODEL=qwen3.6-35b-a3b

# Fallback max_tokens when Claude Code omits it (Anthropic requires it, so this is rarely hit).
DEFAULT_MAX_TOKENS=1024

# debug | info | silent
LOG_LEVEL=info