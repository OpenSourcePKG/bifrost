{
  "name": "bifrost",
  "version": "0.1.0",
  "description": "Bifröst — an Anthropic Messages ↔ OpenAI chat-completions bridge, so Claude Code can drive a MimirMind (OpenAI-compatible) inference server.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "serve": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "vts": "github:OpenSourcePKG/vts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}